DATABASE_URL="file:./dev.db"
# Enable disposable prototype tools explicitly; use production for real data.
APP_ENV="testing"
ENABLE_DEMO_LOGIN="true"
# Production cookies are secure by default. False is only for local HTTP tests.
# COOKIE_SECURE="false"

# File-byte budget per school (templates, versions and report assets).
PORTAL_STORAGE_MB=512

# Testing defaults allow a small amount of image evidence. Set false for a text-first pilot.
PORTAL_STUDENT_IMAGES=true
# Total uploaded evidence/reviewed documents per student account across its reports.
PORTAL_STUDENT_UPLOAD_MB=3
PORTAL_STUDENT_IMAGE_COUNT=5
