# ────────────────────────────────────────────────────────────
# Practicum Evaluation Portal — Environment Variables
# ────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values as needed.
#
#   cp .env.example .env
#
# The database path should be RELATIVE to the project root so it
# works on any machine. The `db/` folder is gitignored.
# ────────────────────────────────────────────────────────────

# SQLite database location (Prisma + SQLite)
# After changing this, run `bun run db:push` to (re)create the DB.
DATABASE_URL=file:./db/custom.db
