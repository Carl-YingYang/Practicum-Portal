generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Versioned school aggregate: flexible form schemas stay JSON during testing.
// Accounts, sessions, rate limits and retry receipts have separate constraints.
model PortalSchool {
  id        String   @id
  name      String
  stateJson String
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
  accounts  PortalAccount[]
}

model PortalAccount {
  id                 String @id
  schoolId           String
  profileId          String
  role               String
  email              String @unique
  passwordHash       String
  status             String @default("active")
  mustChangePassword Boolean @default(false)
  isDemo             Boolean @default(false)
  writingPreferencesJson String @default("{}")
  school             PortalSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions           PortalSession[]
  receipts           PortalReceipt[]
  @@unique([schoolId, role, profileId])
  @@index([schoolId])
}

model PortalSession {
  tokenHash String @id
  accountId String
  expiresAt DateTime
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model PortalReceipt {
  id        String @id @default(cuid())
  accountId String
  requestId String
  createdAt DateTime @default(now())
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, requestId])
}

model PortalLoginAttempt {
  key        String @id
  count      Int @default(0)
  resetAt    DateTime
}
